# AUTOGENERATED starter by coding-agent-playbook `playbook init`.
# Air-gapped-friendly: all hooks are `repo: local` + `language: system`, so
# pre-commit never reaches out to clone hook repos. This requires ruff and
# mypy to be installed in your environment (e.g. your project's dev extras);
# `language: system` runs the tools on PATH, it does NOT install them.
default_language_version:
  python: python3.12
fail_fast: false
repos:
  - repo: local
    hooks:
      # The playbook — sync drift check
      - id: coding-agent-playbook-sync
        name: coding-agent-playbook sync
        entry: playbook sync --check
        language: system
        pass_filenames: false
        always_run: true
      # The playbook — static code-quality gate (non-regression vs HEAD).
      # STATIC ONLY: this never runs your test suite. Execution evaluators
      # (`playbook metrics --run-tests`) are deliberately excluded from the
      # default hook (side effects + cost) — wire them into CI instead.
      - id: coding-agent-playbook-metrics
        name: coding-agent-playbook metrics (static)
        entry: playbook metrics --baseline git:HEAD
        language: system
        types_or: [python, pyi]
        require_serial: true
      # Linting and formatting (ruff must be installed)
      - id: ruff
        name: ruff (lint + autofix)
        entry: ruff check --fix
        language: system
        types_or: [python, pyi]
        require_serial: true
      - id: ruff-format
        name: ruff format
        entry: ruff format
        language: system
        types_or: [python, pyi]
        require_serial: true
      # Type checking (mypy must be installed)
      - id: mypy
        name: mypy
        entry: mypy --config-file=pyproject.toml
        language: system
        pass_filenames: false
        always_run: true
