feat(feeds): FEED_STORAGE_FTP_ACTIVE setting for FTP active mode

diff --git a/src/feedstorage.py b/src/feedstorage.py
--- a/src/feedstorage.py
+++ b/src/feedstorage.py
@@ -13,23 +13,26 @@ class FTPFeedStorage:
     """Uploads a finished feed file to a path on an FTP server."""
 
     def __init__(
-        self, host: str, path: str, *, port: int = 21, username: str = "", password: str = ""
+        self, host: str, path: str, *, port: int = 21, username: str = "", password: str = "", active: bool = False
     ) -> None:
         self.host = host
         self.path = path
         self.port = port
         self.username = username
         self.password = password
+        self.active = active
 
     @classmethod
     def from_settings(cls, settings: Settings, host: str, path: str) -> FTPFeedStorage:
-        return cls(host, path)
+        return cls(host, path, active=settings["FEED_STORAGE_FTP_ACTIVE"] or False)
 
     def store(self, file: BinaryIO) -> None:
         file.seek(0)
         ftp = FTP()
         ftp.connect(self.host, self.port)
         ftp.login(self.username, self.password)
+        if self.active:
+            ftp.set_pasv(False)
         dirname, filename = posixpath.split(self.path)
         ftp.cwd(dirname)
         ftp.storbinary(f"STOR {filename}", file)
