restock(): add units to an item by SKU, with tests

diff --git a/src/inventory.py b/src/inventory.py
--- a/src/inventory.py
+++ b/src/inventory.py
@@ -18,3 +18,17 @@
 def total_units(items: list[Item]) -> int:
     """Units in stock across every item."""
     return sum(item.quantity for item in items)
+
+
+def restock(items: list[Item], sku: str, units: int) -> Item:
+    """Add ``units`` to the item ``sku`` and return that item.
+
+    Raises ValueError when ``units`` is not positive, KeyError when no item has ``sku``.
+    """
+    if units <= 0:
+        raise ValueError(f"units must be positive, got {units}")
+    for item in items:
+        if item.sku == sku:
+            item.quantity += units
+            return item
+    raise KeyError(sku)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,6 +1,25 @@
-from src.inventory import Item, total_units
+import pytest
+
+from src.inventory import Item, restock, total_units
 
 
 def test_total_units_sums_every_item() -> None:
     items = [Item("pen", 3, 1), Item("ink", 4, 2)]
     assert total_units(items) == 7
+
+
+def test_restock_adds_units_to_the_matching_item() -> None:
+    items = [Item("pen", 3, 1), Item("ink", 4, 2)]
+    assert restock(items, "ink", 5) == Item("ink", 9, 2)
+    assert items[0] == Item("pen", 3, 1)
+
+
+@pytest.mark.parametrize("units", [0, -2])
+def test_restock_rejects_units_that_are_not_positive(units: int) -> None:
+    with pytest.raises(ValueError, match="units must be positive"):
+        restock([Item("pen", 3, 1)], "pen", units)
+
+
+def test_restock_raises_key_error_for_an_unknown_sku() -> None:
+    with pytest.raises(KeyError):
+        restock([Item("pen", 3, 1)], "ink", 1)
