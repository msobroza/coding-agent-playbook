diff --git a/src/units.py b/src/units.py
new file mode 100644
--- /dev/null
+++ b/src/units.py
@@ -0,0 +1,15 @@
+"""Weight conversions for the shipping quotes."""
+
+#: Kilograms in one of each supported unit; the pound is exact by definition.
+KILOGRAMS_PER_UNIT: dict[str, float] = {"kg": 1.0, "lb": 0.45359237}
+
+
+def to_kilograms(weight: float, unit: str) -> float:
+    """``weight`` given in ``unit``, as kilograms; an unknown unit raises ``ValueError``."""
+    try:
+        factor = KILOGRAMS_PER_UNIT[unit]
+    except KeyError:
+        raise ValueError(
+            f"unknown weight unit {unit!r}; expected one of {sorted(KILOGRAMS_PER_UNIT)}"
+        ) from None
+    return weight * factor
diff --git a/tests/test_shipping.py b/tests/test_shipping.py
--- a/tests/test_shipping.py
+++ b/tests/test_shipping.py
@@ -14,3 +14,13 @@ def test_a_whole_kilogram_is_charged_once() -> None:
 def test_a_non_positive_weight_is_rejected() -> None:
     with pytest.raises(ValueError, match="positive"):
         quote_cents(0)
+
+
+def test_a_weight_in_pounds_is_charged_per_started_kilogram() -> None:
+    # 5 lb is about 2.27 kg, so three kilograms are charged.
+    assert quote_cents(5, "lb") == 450 + 3 * 120
+
+
+def test_an_unknown_unit_is_rejected() -> None:
+    with pytest.raises(ValueError, match="unknown weight unit"):
+        quote_cents(1, "oz")
