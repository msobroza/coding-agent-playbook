## Good Example

```python
class SchemaMismatchError(ValueError):
    """Loaded data does not have the columns, dtypes or shape the code expects."""
{% if has_ml_dep("numpy") %}


def load_embeddings(path: Path, *, dim: int) -> npt.NDArray[np.float32]:
    array = np.load(path, allow_pickle=False)
    if array.dtype != np.float32 or array.ndim != 2 or array.shape[1] != dim:
        raise SchemaMismatchError(
            f"{path.name}: expected float32 of shape (n, {dim}), got {array.dtype} {array.shape}"
        )
    return array
{% endif %}
{% if has_ml_dep("pandas") %}


ORDER_DTYPES = {"order_id": "int64", "zip_code": "string", "weight_kg": "float64"}


def check_dtypes(frame: pd.DataFrame, expected: Mapping[str, str]) -> None:
    actual = frame.dtypes.astype(str).to_dict()
    for column, dtype in expected.items():
        got = actual.get(column)
        if got != dtype:
            raise SchemaMismatchError(f"{column!r}: expected {dtype}, got {got}")


def load_orders(path: Path) -> pd.DataFrame:
    orders = pd.read_parquet(path)
    check_dtypes(orders, ORDER_DTYPES)
    return orders
{% endif %}
{% if has_ml_dep("polars") %}


ORDER_SCHEMA = {"order_id": pl.Int64, "zip_code": pl.String, "weight_kg": pl.Float64}


def check_schema(frame: pl.DataFrame, expected: Mapping[str, pl.DataType]) -> None:
    actual = frame.schema
    for column, dtype in expected.items():
        got = actual.get(column)
        if got != dtype:
            raise SchemaMismatchError(f"{column!r}: expected {dtype}, got {got}")


def load_orders(path: Path) -> pl.DataFrame:
    orders = pl.read_parquet(path)
    check_schema(orders, ORDER_SCHEMA)
    return orders
{% endif %}
```

## Notes

- Check once at the boundary (a load, an API response, the output of an upstream pipeline stage), not inside every transformation.
- Raise an error, never `assert`: assertions vanish under `python -O`, and the message must name what arrived and what was expected.
- A read that declares its dtypes (`ml-dtypes-at-load`) still needs this check when the source carries its own schema, such as Parquet, a database table or an array file, because that schema can drift.
{% if has_ml_dep("pandas") or has_ml_dep("polars") %}
- When the repo already uses pandera, write the frame check as one schema validated at the same boundary (`ml-frame-validation`). Never add pandera for this on your own; propose it to the user if the checks keep growing.
{% endif %}
