    return a @ b / (np.linalg.norm(a) * np.linalg.norm(b))


def load_matrix(path) -> np.ndarray:  # dtype? shape?
    ...
{% endif %}
{% if has_ml_dep("pandas") %}
{% if has_ml_dep("numpy") %}


{% endif %}
