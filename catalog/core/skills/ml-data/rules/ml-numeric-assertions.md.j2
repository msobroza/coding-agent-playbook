## Good Example

```python
{% if has_ml_dep("numpy") %}
def test_normalize() -> None:
    result = normalize(np.array([1.0, 2.0, 3.0]))
    np.testing.assert_allclose(result, [-1.2247, 0.0, 1.2247], rtol=1e-4, atol=1e-12)


def test_assign_ids_is_exact() -> None:
    np.testing.assert_array_equal(assign_ids(3), np.array([0, 1, 2]))  # ints: exact
{% endif %}
{% if has_ml_dep("pandas") %}
{% if has_ml_dep("numpy") %}


{% endif %}
def test_summarize() -> None:
    readings = pd.DataFrame({"site": ["x", "x", "y"], "celsius": [1.0, 2.0, 4.0]})
    expected = pd.DataFrame(
        {"site": ["x", "y"], "mean_celsius": [1.5, 4.0]},  # computed by hand
    )
    pd.testing.assert_frame_equal(summarize(readings), expected)
{% endif %}
